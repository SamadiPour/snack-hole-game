{
  "name": "snack-hole",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5101 --strictPort",
    "play": "vite build --outDir .play --emptyOutDir && vite preview --outDir .play --port 5101 --strictPort",
    "itch": "tsc --noEmit && vite build --base=./ --outDir itch/build --emptyOutDir && rm itch/build/sw.js && rm -f itch/snack-hole.zip && cd itch/build && zip -qrX ../snack-hole.zip .",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "sim:tour": "tsx scripts/tour-sim.ts",
    "sim:cosmos": "tsx scripts/cosmos-sim.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
